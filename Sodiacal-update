        pcall(function()
            if not g then return end
            g.DescendantAdded:Connect(function(o) if o:IsA("TextLabel") then watch(o) end end)
            for _, v in pairs(g:GetDescendants()) do if v:IsA("TextLabel") then watch(v) end end
        end)
    end
    pcall(function() local pg = lp:WaitForChild("PlayerGui", 10); if pg then hook(pg) end end)
